| makeresults count=1
| streamstats count as rownum
| eval EventCode=10,
    _time=1735689660,
    Computer="host-a",
    TargetImage="C:\\Windows\\System32\\lsass.exe.bak",
    TargetProcessId=500,
    SourceImage="C:\\Tools\\diagnostic.exe",
    SourceProcessId=100,
    CallTrace="C:\\Windows\\System32\\dbghelp.dll+0x10"
| fields EventCode _time Computer TargetImage TargetProcessId SourceImage SourceProcessId CallTrace
| eval diagnostic_time_epoch=_time
| sort 0 EventCode _time Computer TargetImage TargetProcessId SourceImage SourceProcessId CallTrace
| table EventCode _time Computer TargetImage TargetProcessId SourceImage SourceProcessId CallTrace diagnostic_time_epoch
